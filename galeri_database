--9.Soru: 200000 den fazla tutara satılan araçları kimlerin hangi aracı aldığını listelemek için gerekli kodu yazınız?
 
select c.Marka,c.model,m.M_Adi,m.M_Soyadi from Satış as s join Arac as c on c.Arac_No=s.Arac_No join Müsteri as m on m.M_No=s.M_No where Sat_Fiyat>200000

--10.Soru: Tokatta bulunan müşterilere satışı ytapılan araçları listelemek için gerekli kodu yazınız?

 select *from Satış as s join Müsteri as m on m.M_No=s.M_No join Arac as c on s.M_No=m.M_No where M_Adres='Tokat/Turhal'
