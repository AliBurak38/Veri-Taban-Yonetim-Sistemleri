               ----Sorular-----

--1.Soru: Satış yapılan müşterilerin isimlerini listelemek için gerekli kodu yazınız? 

select s.Sat_No,m.M_Adi,m.M_Soyadi from Satış as s join Müsteri as m on s.M_No=m.M_No


--2.Soru:Hangi müşteriden hangi aracın alındığını listelemek için gerekli kodu yazınız?

select a.Alim_No,m.M_Adi+' '+m.M_Soyadi'Musteri AdSoyad',c.Marka+' '+c.Model 'Arac MarkaModel' from Alım as a join Müsteri as m on a.M_No=m.M_No join Arac as c on a.Arac_No=c.Arac_No


--3.Soru:Her bir müşteriden alınan araçların sayısını listelemek için gerekli kodu yazınız?

select Count(Alim_No)from Alım


--4.Soru:Satılan araçların marka ve modelini listelemek için gerekli kodu yazınız?

select s.Sat_No,a.Marka+' '+a.Model 'Arac Marka Model' from Satış as s join Arac as a on s.Arac_No=a.Arac_No


--5.Soru:Toplam satış ve toplam alım tutarlarını ve bunların farkını bulan kodu yazınız?

Select (SELECT SUM(Alim_Fiyat) FROM Alım) - (SELECT SUM(Sat_Fiyat) FROM Satış) AS KarTutar;


--7.Soru: Her aracın ortalama satış fiyatını bulan kodu yazınız?
select AVG(Sat_Fiyat)from Satış 


--6.Soru: Hiç satışı yapılmamış araçları listelemek için gerekli kodu yazınız ?

select *from Alım as a Left JOIN Satış as s on a.Arac_No = s.Arac_No where s.Arac_No IS NULL;


--7.Soru: Her aracın ortalama satış fiyatını bulan kodu yazınız?
select AVG(Sat_Fiyat)from Satış 

--8.Soru: Alımı ve satışı yapılan tüm araçların marka,model ve alım-satış sayısını listelemek için gerekli kodu yazınız ?

select  c.Marka,c.model  from Alım as a join Arac as c on c.Arac_No=a.Arac_No --alımı yapılan araba markaları 

select  c.Marka,c.model  from Satış as s join Arac as c on c.Arac_No=s.Arac_No --satışı yapılan araba markaları 

