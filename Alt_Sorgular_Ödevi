                 ---Sorular---

1.Soru: Turgut özsevene satılan aracın aynısından başka hangi müşterilere satıldığını bulan sorguyu yazınız?

select  m2.M_Adi+' '+ m2.M_Soyadi 'Musteri Ad Soyad' from Satış as s2 join Müsteri  m2 on s2.M_No=m2.M_No where s2.Arac_No=(select  s.Arac_No  from Satış  as s join Müsteri  as m on s.M_No=m.M_No where m.M_Adi='Turgut')


2.Soru: Satışı yapılan araçları listelemek için gerekli sorguyu yazınız?

select a.Marka,a.Model from  Satış as s  join Arac as a on s.Arac_No=a.Arac_No 

3.Soru: satış fiyatı alış fiyatından düşük olan araçları listeleyen sorguyu yazınız? 

select *from Alım as a join Satış as s on a.Arac_No=(s.Arac_No join Müsteri as m on m.M_No=s.M_No where s.Sat_Fiyat<a.Alim_Fiyat)


4.Soru:Opel marka araç yapılan satışların ve alımların hangi müşterilere yapıldığını bulan sorguyu yazınız?

--Satışı yapılan opel araçlar
select *from Satış as s where s.Arac_No=(select Arac.Arac_No from Arac where Arac.Marka='Opel')

--Alımı yapılan Opel Araçlar 
select  m.M_Adi,m.M_Soyadi from Alım as al join Müsteri as m on m.M_No=al.M_No where al.Arac_No=(select  a.Arac_No from Arac as a where a.Marka='Opel')

5.Soru:Araç fiyatı 200000 den yüksek olan araçların hangi fiyata satıldğını bulan sorguyu yazınız? 

select s.Sat_Fiyat,a.Marka,a.Model from  Satış as s  join Arac as a on s.Arac_No=a.Arac_No  where s.Arac_No in (select a.Arac_No from Arac as a where a.Fiyat>'200000')

6.Soru:Turhal ve Amasyaya yapılan satışların toplam tutarını azalan sırada listeleyen sorguyu yazınız?

select  s.Sat_Fiyat  from Satış as s join Müsteri as m on m.M_No=s.M_No where m.M_Adres='Tasova/Amasya' or m.M_Adres='Turhal/Tokat' order by s.Sat_Fiyat desc 

7.Soru:Satış veya alımı yapılmayan müşterileri bulan sorguyu yazınız?

-- Araç Satılmayan müşteriler--

select *from Müsteri as m where m.M_No not in (select Satış.M_No from  Satış )

--Araç alınmayan müşteriler--

select *from Müsteri as m where m.M_No not in (select Alım.M_No from Alım)

8.Soru= 5.ve 6.ayda yapılan satışların kimlere olduğunu bulan sorguyu yazınız?

select m.M_Adi+' '+m.M_Soyadi 'AdSoyad'from Müsteri as m  where  m.M_No in(select Satış.M_No from  Satış where Sat_Tarih='04.05.2022' or Sat_Tarih='01.06.2020')

9.Soru:aynı marka araç alan müşterileri listeleyen sorguyu yazınız?

SELECT s.Arac_NoFROM Alım s GROUP BY s.Arac_No HAVING COUNT(DISTINCT s.M_No) > 1;

